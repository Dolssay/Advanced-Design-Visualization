# Rendered at container start by the nginx image's envsubst step:
# ${BACKEND_URL} comes from the environment (default set in the Dockerfile).
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;

  gzip on;
  gzip_types text/css application/javascript application/json text/csv image/svg+xml;
  gzip_min_length 1024;

  # API: forwarded with the path unchanged, so /api/v1/evtol/size reaches the
  # FastAPI route /api/v1/evtol/size. Same behaviour as the Vite dev proxy.
  location /api/ {
    proxy_pass ${BACKEND_URL};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
  }

  # nginx's default MIME table has no .csv entry, which would also skip gzip.
  # Demo 1's 6.9 MB GTB777.csv gzips to under half (6.9 MB -> 3.2 MB).
  location /data/ {
    types { text/csv csv; }
    try_files $uri =404;
  }

  # Hashed build assets never change.
  location /assets/ {
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location / {
    try_files $uri $uri/ $uri/index.html =404;
  }
}
